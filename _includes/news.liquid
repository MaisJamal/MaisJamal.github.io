<div class="news">
  {% if site.news != blank %}
    {% assign all_news = site.news | reverse %}
    {% comment %} Filter news by language {% endcomment %}
    {% assign filtered_news = "" | split: "" %}
    {% for item in all_news %}
      {% if page.lang == 'ar' %}
        {% if item.lang == 'ar' %}
          {% assign filtered_news = filtered_news | push: item %}
        {% endif %}
      {% else %}
        {% unless item.lang == 'ar' %}
          {% assign filtered_news = filtered_news | push: item %}
        {% endunless %}
      {% endif %}
    {% endfor %}
    {% assign news_size = filtered_news | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in filtered_news limit: news_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>{% if page.lang == 'ar' %}لا توجد أخبار حتى الآن...{% else %}No news so far...{% endif %}</p>
  {% endif %}
</div>
